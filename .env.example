# Local-only database password. Set a different value for any shared environment.
FINBRIDGE_DB_PASSWORD=finbridge-local-only
FINBRIDGE_DB_PORT=5432
FINBRIDGE_CONSOLE_PORT=5173

# When the host API runs on the same machine outside Compose, use this default.
# For an API service added to Compose later, set this to its service URL, e.g. http://api:8080.
FINBRIDGE_API_PROXY_TARGET=http://host.docker.internal:8080
